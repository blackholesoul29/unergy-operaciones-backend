# ── Base de datos ──────────────────────────────────────────
POSTGRES_DB=operaciones
POSTGRES_USER=operaciones
POSTGRES_PASSWORD=cambia_esto_en_produccion
DATABASE_URL=postgresql://operaciones:cambia_esto_en_produccion@db:5432/operaciones

# ── Seguridad ───────────────────────────────────────────────
SECRET_KEY=genera-una-clave-segura-con-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=480

# ── Almacenamiento de archivos ──────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/uploads
# Para S3/R2 (descomentar cuando sea necesario):
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT=https://...
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

# ── Aplicación ──────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=Plataforma Operaciones Unergy
FRONTEND_URL=http://localhost:5173

# Copia este archivo a .env (cp .env.example .env) y completa los valores.
# Requiere las dependencias del proyecto: pip install -r requirements.txt
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/operaciones
SECRET_KEY=change-me-to-a-secure-random-string
JWT_EXPIRE_MINUTES=480
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=uploads
ENVIRONMENT=development
APP_NAME=Plataforma Operaciones Unergy
FRONTEND_URL=http://localhost:5173

# Unergy API — credenciales del backend de la app (legacy bridge).
# NO confundir con UNERGY_API_EMAIL/PASS de abajo (esas son para los scripts de carga).
UNERGY_API_URL=https://api.unergy.io
UNERGY_ACCOUNT_ID=
UNERGY_LOGIN=
UNERGY_PASSWORD=

# API de Liquidaciones (mismo host que UNERGY_API_URL). La cuenta debe estar en
# el grupo `admin` Y tener is_staff=True. Si se dejan vacías se usan UNERGY_*.
LIQUIDACIONES_LOGIN=
LIQUIDACIONES_PASSWORD=
# Clave de Gemini con la que la API lee los PDF de las facturas de XM.
# Opcional: vacía = esa API usa la suya.
LIQUIDACIONES_GEMINI_API_KEY=

# Credenciales para los SCRIPTS DE CARGA hand-invoked (scripts/cargar_*.py,
# reconciliar_*.py, migrate_fallas_desde_sheets.py). Las leen vía scripts/_creds.py.
# Es el login (email + password) de un usuario de la plataforma de operaciones.
UNERGY_API_EMAIL=
UNERGY_API_PASS=

# Contraseña inicial de los usuarios sembrados por app/seeds/seed_data.py.
# Cámbiala antes de sembrar en cualquier entorno real; los usuarios deben rotarla.
SEED_USER_PASSWORD=changeme123

# Solenium API (FMO)
SOLENIUM_AUTH_URL=https://auth.solenium.co/api/token/
SOLENIUM_DATA_URL=https://data.solenium.co/api
SOLENIUM_USER=
SOLENIUM_PASS=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=operaciones@unergy.io

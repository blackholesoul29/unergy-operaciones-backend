DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/operaciones
SECRET_KEY=change-me-to-a-secure-random-string
JWT_EXPIRE_MINUTES=480
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=uploads
ENVIRONMENT=development
APP_NAME=Plataforma Operaciones Unergy
FRONTEND_URL=http://localhost:5173

# Unergy API
UNERGY_API_URL=https://api.unergy.io
UNERGY_ACCOUNT_ID=
UNERGY_LOGIN=
UNERGY_PASSWORD=

# Solenium API (FMO)
SOLENIUM_AUTH_URL=https://auth.solenium.co/api/token/
SOLENIUM_DATA_URL=https://data.solenium.co/api
SOLENIUM_USER=
SOLENIUM_PASS=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=operaciones@unergy.io

# ── Seguridad de contraseñas semilla / scripts ───────────────────────────────
# IMPORTANTE: las contraseñas iniciales de los usuarios sembrados son ALEATORIAS
# y deben cambiarse en el primer acceso. No hay contraseñas por defecto.
#
# Clave Fernet para cifrar app/seeds/seed_passwords.json.enc en producción.
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SEED_FERNET_KEY=
#
# Credenciales para migrate_fallas_desde_sheets.py (NUNCA hardcodear).
# Preferido: una API key de cuenta de servicio (tabla api_keys).
ADMIN_API_KEY=
# Fallback: usuario/contraseña de un admin real.
ADMIN_USER=
ADMIN_PASS=
# URL base de la API de operaciones (opcional, por defecto producción).
OPS_API_BASE=

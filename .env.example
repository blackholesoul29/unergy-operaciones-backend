DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/operaciones
# SECRET_KEY (obligatorio): la app NO arranca sin una clave de >=32 chars.
# Genera una única por entorno y nunca la subas al repo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
JWT_EXPIRE_MINUTES=480
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=uploads
ENVIRONMENT=development
APP_NAME=Plataforma Operaciones Unergy
FRONTEND_URL=http://localhost:5173

# Unergy API
UNERGY_API_URL=https://api.unergy.io
UNERGY_ACCOUNT_ID=
UNERGY_LOGIN=
UNERGY_PASSWORD=

# Solenium API (FMO)
SOLENIUM_AUTH_URL=https://auth.solenium.co/api/token/
SOLENIUM_DATA_URL=https://data.solenium.co/api
SOLENIUM_USER=
SOLENIUM_PASS=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=operaciones@unergy.io

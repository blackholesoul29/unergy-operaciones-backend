DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/operaciones
SECRET_KEY=change-me-to-a-secure-random-string
JWT_EXPIRE_MINUTES=480
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=uploads
ENVIRONMENT=development
APP_NAME=Plataforma Operaciones Unergy
FRONTEND_URL=http://localhost:5173

# Unergy API
UNERGY_API_URL=https://api.unergy.io
UNERGY_ACCOUNT_ID=
UNERGY_LOGIN=
UNERGY_PASSWORD=

# Solenium API (FMO)
SOLENIUM_AUTH_URL=https://auth.solenium.co/api/token/
SOLENIUM_DATA_URL=https://data.solenium.co/api
SOLENIUM_USER=
SOLENIUM_PASS=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=operaciones@unergy.io

# Migración de fallas (migrate_fallas_desde_sheets.py)
#   API_EMAIL / API_PASS: credenciales OBLIGATORIAS para autenticarse contra la
#       plataforma de operaciones. Sin ellas el script aborta.
#   API_BASE: URL base de la API (incluye /api/v1). Opcional: si se omite se usa
#       el endpoint de producción por defecto.
API_EMAIL=usuario@unergy.io
API_PASS=
API_BASE=https://backend-production-63d8.up.railway.app/api/v1
